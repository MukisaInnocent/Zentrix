NODE_ENV=development
PORT=3000
DATABASE_URL=postgres://zentrix:zentrix@localhost:5432/zentrix
DATABASE_SSL=false
DEMO_PAYMENTS_ENABLED=false
# Email through the Resend API instead of SMTP (sign-in codes for staff are emailed). Without a verified
# domain use MAIL_FROM=Zentrix <onboarding@resend.dev>; Resend then delivers only to your Resend account email.
RESEND_API_KEY=
# Test seed only: the inbox given to the seeded zx_admin account.
SEED_ADMIN_EMAIL=
