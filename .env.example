NODE_ENV=development
PORT=3000
DATABASE_URL=postgres://zentrix:zentrix@localhost:5432/zentrix
DATABASE_SSL=false
DEMO_PAYMENTS_ENABLED=false
# Email through the Resend API instead of SMTP (sign-in codes for staff are emailed). Mail goes out from
# info@pexerearn.com once pexerearn.com is verified in Resend (docs/DOMAIN.md). Before that, set
# MAIL_FROM=Pexerearn <onboarding@resend.dev>; Resend then delivers only to your Resend account email.
RESEND_API_KEY=
MAIL_FROM=Pexerearn <info@pexerearn.com>
# Signing secret (whsec_...) of the Resend webhook at <site>/api/webhooks/resend that reports delivery.
RESEND_WEBHOOK_SECRET=
# Exchange rates for referral rewards across countries: open-er-api (default, no key needed) or none.
FX_PROVIDER=open-er-api
# Test seed only: the inbox given to the seeded zx_admin account.
SEED_ADMIN_EMAIL=
