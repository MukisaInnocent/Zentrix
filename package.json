{
  "name": "zentrix",
  "version": "0.1.0",
  "private": true,
  "description": "Zentrix member platform: funded tasks, learning and a multi-currency wallet. Test stage.",
  "license": "UNLICENSED",
  "type": "module",
  "engines": {
    "node": ">=20.19.0"
  },
  "scripts": {
    "dev": "tsx server/scripts/dev.ts",
    "db:up": "tsx server/scripts/dev.ts --db-only",
    "build": "tsc -p server/tsconfig.build.json",
    "start": "node server/dist/src/main.js",
    "worker": "node server/dist/src/worker.js",
    "migrate": "tsx server/scripts/migrate.ts",
    "seed": "tsx server/scripts/seed.ts",
    "admin:create": "tsx server/scripts/admin-create.ts",
    "totp": "tsx server/scripts/totp-code.ts",
    "golive": "tsx server/scripts/golive.ts",
    "gen:reference-data": "tsx server/scripts/gen-reference-data.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint .",
    "typecheck": "tsc -p server/tsconfig.json --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "npm run lint && npm run typecheck && npm test"
  },
  "dependencies": {
    "@node-rs/argon2": "2.2.2",
    "dotenv": "18.0.6",
    "express": "5.2.1",
    "express-rate-limit": "8.7.1",
    "helmet": "8.3.0",
    "libphonenumber-js": "1.13.14",
    "node-cron": "4.6.0",
    "node-pg-migrate": "9.0.0",
    "nodemailer": "10.0.15",
    "otpauth": "9.5.2",
    "pg": "8.23.1",
    "pino": "10.4.0",
    "qrcode": "1.5.4",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/express": "5.0.6",
    "@types/node": "20.19.43",
    "@types/nodemailer": "8.0.2",
    "@types/pg": "8.23.1",
    "@types/qrcode": "1.5.6",
    "countries-and-timezones": "3.10.0",
    "countries-list": "3.4.1",
    "currency-codes": "2.2.0",
    "embedded-postgres": "17.10.0-beta.17",
    "eslint": "10.12.0",
    "fast-check": "4.10.2",
    "globals": "17.13.0",
    "node-html-parser": "9.0.4",
    "prettier": "3.9.9",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.1",
    "vitest": "4.1.11"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "@embedded-postgres/windows-x64@17.10.0-beta.17": true,
    "@embedded-postgres/linux-x64@17.10.0-beta.17": true,
    "@embedded-postgres/darwin-arm64@17.10.0-beta.17": true
  }
}
